{
  "manifest_version": 3,
  "name": "Youtube Bilibili Digest",
  "version": "1.4.0",
  "minimum_chrome_version": "116",
  "description": "Turn YouTube and Bilibili videos into learning resources with transcripts, bilingual translation, AI overviews, and notes. One-click Word transcript generation via local server.",
  "permissions": ["sidePanel", "storage", "tabs", "scripting"],
  "host_permissions": [
    "https://*/*",
    "http://127.0.0.1:18765/*"
  ],
  "action": {
    "default_title": "Open YouTube Digest",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.bilibili.com/video/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
